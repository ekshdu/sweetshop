        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UC4_Activity\n!theme plain\nskinparam backgroundColor #FFFFFF\nskinparam activity {\n  BackgroundColor #E8F4FD\n  BorderColor #2E86AB\n  FontName Arial\n  FontSize 12\n}\nskinparam activityDiamond {\n  BackgroundColor #FFF3CD\n  BorderColor #856404\n}\n\ntitle Диаграмма деятельности UC-4\\nУправление складом сырья и ценообразованием\n\n|Администратор|\nstart\n:Просмотреть остатки сырья\\nи уведомления о низких\\nостатках / сроках годности;\n:Внести данные о поступившей\\nпартии (наименование, кол-во,\\nцена, срок годности);\n\n|Система|\nif (Закупочная цена указана?) then (нет)\n  |Администратор|\n  :Ввести цену вручную;\nendif\n\n|Система|\n:Пересчитать себестоимость\\nвсех изделий с данным сырьём\\nпо формуле (1);\n\nif (Себестоимость &gt; порога\\nрентабельности?) then (да)\n  :Выделить изделие\\nкак убыточное;\n  |Администратор|\n  :Скорректировать цену\\nпозиции каталога;\nendif\n\n|Администратор|\n:Сформировать аналитический\\nотчёт (выручка, себестоимость,\\nприбыль) за период;\n:Сохранить / экспортировать отчёт;\nstop\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dLjJnPX8XXEcDXeNIJQp-81">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Администратор" plantUmlId="lane_48" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontColor=#000000;fontSize=18;fontStyle=0;html=1;shadow=0;fontFamily=Verdana;" plantUmlBaseValue="Администратор" id="dLjJnPX8XXEcDXeNIJQp-82">
