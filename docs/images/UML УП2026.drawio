        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml class_services\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\nskinparam classAttributeIconSize 0\nskinparam roundCorner 0\nskinparam nodesep 30\nskinparam ranksep 45\nskinparam ArrowColor #000000\nskinparam ArrowFontSize 11\nskinparam class {\n  BackgroundColor #F5F5F5\n  BorderColor #000000\n  HeaderBackgroundColor #E0E0E0\n}\nhide empty members\nhide circle\nskinparam nodesep 20\nskinparam ranksep 60\n\ninterface IAuthService {\n  \&quot;+authenticate()\&quot;\n  \&quot;+get_current_user()\&quot;\n  \&quot;+check_access()\&quot;\n}\ninterface IOrderService {\n  \&quot;+calculate_price()\&quot;\n  \&quot;+create_order()\&quot;\n  \&quot;+change_status()\&quot;\n  \&quot;+get_client_orders()\&quot;\n  \&quot;+set_cost_price()\&quot;\n}\ninterface IPaymentService {\n  \&quot;+pay()\&quot;\n}\ninterface IStockService {\n  \&quot;+register_batch()\&quot;\n  \&quot;+is_available()\&quot;\n  \&quot;+reserve()\&quot;\n  \&quot;+write_off()\&quot;\n  \&quot;+find_expiring()\&quot;\n}\ninterface IProductionService {\n  \&quot;+get_calendar()\&quot;\n  \&quot;+start_cooking()\&quot;\n  \&quot;+finish_cooking()\&quot;\n}\ninterface IDeliveryService {\n  \&quot;+assign_courier()\&quot;\n  \&quot;+pick_up()\&quot;\n  \&quot;+complete()\&quot;\n  \&quot;+report_problem()\&quot;\n  \&quot;+estimate_arrival()\&quot;\n}\ninterface IAnalyticsService {\n  \&quot;+financial_report()\&quot;\n  \&quot;+logistics_report()\&quot;\n}\ninterface INotificationService {\n  \&quot;+notify()\&quot;\n  \&quot;+get_unread()\&quot;\n  \&quot;+mark_read()\&quot;\n}\ninterface IRepository&lt;T&gt; {\n  \&quot;+get()\&quot;\n  \&quot;+list()\&quot;\n  \&quot;+add()\&quot;\n  \&quot;+update()\&quot;\n  \&quot;+delete()\&quot;\n}\nclass AuthService\nclass OrderService {\n  \&quot;-validate_slot()\&quot;\n}\nclass PricingService {\n  \&quot;+calc_order_price()\&quot;\n  \&quot;+calc_delivery_cost()\&quot;\n}\nclass PaymentEmulator\nclass StockService\nclass CostingService {\n  \&quot;+calc_product_cost()\&quot;\n  \&quot;+recalculate_all()\&quot;\n}\nclass ProductionService\nclass DeliveryService {\n  \&quot;-select_courier()\&quot;\n}\nclass AnalyticsService\nclass NotificationService\nclass SqlRepository&lt;T&gt;\nclass \&quot;API-роутеры\\n(FastAPI)\&quot; as Routers &lt;&lt;controller&gt;&gt;\n\nRouters ..&gt; IAuthService\nRouters ..&gt; IOrderService\nRouters ..&gt; IStockService\nRouters ..&gt; IProductionService\nRouters ..&gt; IDeliveryService\nRouters ..&gt; IAnalyticsService\nRouters ..&gt; INotificationService\nIAuthService &lt;|.. AuthService\nIOrderService &lt;|.. OrderService\nIPaymentService &lt;|.. PaymentEmulator\nIStockService &lt;|.. StockService\nIProductionService &lt;|.. ProductionService\nIDeliveryService &lt;|.. DeliveryService\nIAnalyticsService &lt;|.. AnalyticsService\nINotificationService &lt;|.. NotificationService\nIRepository &lt;|.. SqlRepository\nOrderService *-- PricingService\nStockService *-- CostingService\nOrderService ..&gt; IStockService\nOrderService ..&gt; IPaymentService\nOrderService ..&gt; INotificationService\nProductionService ..&gt; IOrderService\nProductionService ..&gt; IStockService\nProductionService ..&gt; INotificationService\nDeliveryService ..&gt; IOrderService\nDeliveryService ..&gt; INotificationService\nStockService ..&gt; INotificationService\nnote bottom of SqlRepository\n  Репозитории подключаются\n  к сервисам через\n  внедрение зависимостей\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RND87jh0RYhFv7E_JuxQ-87">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
