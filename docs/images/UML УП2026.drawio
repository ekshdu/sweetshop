        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml class_orders\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 13\nskinparam classAttributeIconSize 0\nskinparam roundCorner 0\nskinparam nodesep 30\nskinparam ranksep 45\nskinparam ArrowColor #000000\nskinparam ArrowFontSize 11\nskinparam class {\n  BackgroundColor #F5F5F5\n  BorderColor #000000\n  HeaderBackgroundColor #E0E0E0\n}\nhide empty members\nhide circle\n\nclass User {\n  \&quot;+id: int\&quot;\n  \&quot;+login: str\&quot;\n  \&quot;-password_hash: str\&quot;\n  \&quot;+role: UserRole\&quot;\n  \&quot;+is_active: bool\&quot;\n  \&quot;+verify_password(password): bool\&quot;\n}\nclass Client {\n  \&quot;+first_name: str\&quot;\n  \&quot;+last_name: str\&quot;\n  \&quot;+phone: str\&quot;\n  \&quot;+default_address: str\&quot;\n}\nclass Employee {\n  \&quot;+full_name: str\&quot;\n  \&quot;+position: str\&quot;\n  \&quot;+is_on_shift: bool\&quot;\n}\nclass Notification {\n  \&quot;+id: int\&quot;\n  \&quot;+type: NotificationType\&quot;\n  \&quot;+message: str\&quot;\n  \&quot;+is_read: bool\&quot;\n  \&quot;+mark_read()\&quot;\n}\nclass Review {\n  \&quot;+id: int\&quot;\n  \&quot;+rating: int\&quot;\n  \&quot;+text: str\&quot;\n  \&quot;+is_published: bool\&quot;\n}\nclass Order {\n  \&quot;+id: int\&quot;\n  \&quot;+status: OrderStatus\&quot;\n  \&quot;+total_price: Decimal\&quot;\n  \&quot;+cost_price: Decimal\&quot;\n  \&quot;+delivery_type: DeliveryType\&quot;\n  \&quot;+payment_status: PaymentStatus\&quot;\n  \&quot;+desired_date: date\&quot;\n  \&quot;+can_change_status(new): bool\&quot;\n}\nclass ProductionAssignment {\n  \&quot;+id: int\&quot;\n  \&quot;+planned_date: date\&quot;\n  \&quot;+started_at: datetime\&quot;\n  \&quot;+finished_at: datetime\&quot;\n  \&quot;+start()\&quot;\n  \&quot;+finish()\&quot;\n}\nclass Delivery {\n  \&quot;+id: int\&quot;\n  \&quot;+estimated_arrival: datetime\&quot;\n  \&quot;+problem_reason: str\&quot;\n  \&quot;+is_manual_assignment: bool\&quot;\n  \&quot;+pick_up()\&quot;\n  \&quot;+complete()\&quot;\n  \&quot;+report_problem(reason)\&quot;\n}\nclass DeliveryZone {\n  \&quot;+id: int\&quot;\n  \&quot;+name: str\&quot;\n  \&quot;+price: Decimal\&quot;\n  \&quot;+estimated_minutes: int\&quot;\n}\nclass OrderItem {\n  \&quot;+id: int\&quot;\n  \&quot;+quantity: int\&quot;\n  \&quot;+unit_price: Decimal\&quot;\n  \&quot;+subtotal(): Decimal\&quot;\n}\nclass OrderStatusHistory {\n  \&quot;+id: int\&quot;\n  \&quot;+old_status: OrderStatus\&quot;\n  \&quot;+new_status: OrderStatus\&quot;\n  \&quot;+changed_at: datetime\&quot;\n}\nclass CustomCake #FFFFFF\nclass Product #FFFFFF\n\nUser &lt;|-- Client\nUser &lt;|-- Employee\nUser \&quot;1\&quot; -right- \&quot;0..*\&quot; Notification : получает\nClient \&quot;1\&quot; -down- \&quot;0..*\&quot; Order : оформляет\nClient \&quot;1\&quot; -down- \&quot;0..*\&quot; Review : пишет\nEmployee \&quot;1\&quot; -down- \&quot;0..*\&quot; ProductionAssignment : кондитер\nEmployee \&quot;1\&quot; -down- \&quot;0..*\&quot; Delivery : курьер\nReview \&quot;0..1\&quot; --right-- \&quot;1\&quot; Order\nOrder \&quot;1\&quot; --right-- \&quot;0..1\&quot; ProductionAssignment\nOrder \&quot;1\&quot; -down- \&quot;0..1\&quot; Delivery\nOrder \&quot;1\&quot; *-down- \&quot;1..*\&quot; OrderItem\nOrder \&quot;1\&quot; *-down- \&quot;0..*\&quot; OrderStatusHistory\nOrder \&quot;1\&quot; *-down- \&quot;0..1\&quot; CustomCake\nOrder \&quot;0..*\&quot; -down- \&quot;0..1\&quot; DeliveryZone\nOrderItem \&quot;0..*\&quot; -down- \&quot;1\&quot; Product\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="84391Lcle6Ay3DlrbZ9f-597">
