        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml UC1_Activity\n!theme plain\nskinparam backgroundColor #FFFFFF\nskinparam activity {\n  BackgroundColor #E8F4FD\n  BorderColor #2E86AB\n  FontName Arial\n  FontSize 12\n}\nskinparam activityDiamond {\n  BackgroundColor #FFF3CD\n  BorderColor #856404\n}\nskinparam note {\n  BackgroundColor #F8F9FA\n}\n\ntitle Диаграмма деятельности UC-1\\nОформление заказа клиентом через конструктор торта\n\n|Клиент|\nstart\n:Выбрать основу торта\\n(форма, размер, вес);\n:Выбрать начинку;\n:Выбрать декор и текст\\nпоздравления;\n\n|Система|\n:Рассчитать итоговую стоимость\\nпо формуле (2);\n:Проверить доступность сырья\\nна выбранную дату;\n\nif (Сырьё достаточно?) then (да)\n  :Проверить доступность\\nпроизводственного слота;\n  if (Слот свободен?) then (да)\n    |Клиент|\n    :Указать дату, время\\nи способ получения;\n    :Подтвердить заказ\\nи перейти к оплате;\n    |Система|\n    :Сформировать заказ\\n(статус «Новый»);\n    :Отправить уведомление\\nадминистратору;\n    stop\n  else (нет)\n    :Предложить ближайшие\\nсвободные слоты;\n    |Клиент|\n    :Выбрать другой слот;\n    |Система|\n    :Сформировать заказ\\n(статус «Новый»);\n    :Отправить уведомление\\nадминистратору;\n    stop\n  endif\nelse (нет)\n  :Исключить вариант\\nиз конструктора;\n  :Предложить альтернативу;\n  |Клиент|\n  :Выбрать другой вариант;\n  stop\nendif\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="h8DILYZ-b6DEqwOZ1-6P-40">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
