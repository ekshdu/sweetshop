        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml seq_delivery\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam defaultFontSize 12\nskinparam roundCorner 0\nskinparam ArrowColor #000000\nskinparam sequenceMessageAlign center\nskinparam responseMessageBelowArrow true\nskinparam participant {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n}\nskinparam database {\n  BackgroundColor #FFFFFF\n  BorderColor #000000\n}\nskinparam sequence {\n  LifeLineBorderColor #606060\n  LifeLineBackgroundColor #FFFFFF\n  GroupBorderColor #000000\n  GroupBackgroundColor #FFFFFF\n}\nautonumber \&quot;&lt;b&gt;0.\&quot;\n\nparticipant \&quot;Клиентское\\nприложение\\n(курьер)\&quot; as Web\nparticipant \&quot;Серверная\\nчасть\&quot; as Srv\ndatabase \&quot;База\\nданных\&quot; as Db\nparticipant \&quot;Модуль\\nуведомлений\&quot; as Notif\n\n== Заказ получил статус «Готов» ==\nSrv -&gt; Db : Найти курьеров на смене\\nв зоне доставки\nDb --&gt; Srv : Кандидаты\nSrv -&gt; Db : Назначить курьера\nSrv -&gt; Notif : Уведомить курьера\nNotif --&gt; Srv : OK\n\n== Доставка ==\nWeb -&gt; Srv : Забрал заказ\nactivate Srv\nSrv -&gt; Db : Статус «В доставке»\nDb --&gt; Srv : OK\nSrv -&gt; Notif : Уведомить клиента\\n(время прибытия)\nNotif --&gt; Srv : OK\nSrv --&gt; Web : Статус обновлен\ndeactivate Srv\n\nalt заказ вручен\n  Web -&gt; Srv : Доставлен\n  activate Srv\n  Srv -&gt; Db : Статус «Доставлен»\n  Db --&gt; Srv : OK\n  Srv -&gt; Notif : Уведомить клиента\\nи администратора\n  Notif --&gt; Srv : OK\n  Srv --&gt; Web : Заказ завершен\n  deactivate Srv\nelse проблема с доставкой\n  Web -&gt; Srv : Проблема (причина)\n  activate Srv\n  Srv -&gt; Db : Статус «Проблема с доставкой»\n  Db --&gt; Srv : OK\n  Srv -&gt; Notif : Уведомить администратора\n  Notif --&gt; Srv : OK\n  Srv --&gt; Web : Проблема зафиксирована\n  deactivate Srv\n  opt администратор переназначает курьера\n    Srv -&gt; Db : Назначить другого курьера\n  end\nend\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="lKT5wRqXil1s7B1ZOYO2-74">
